# ============================================================
# AI Clipper — example environment. Copy to .env and fill in.
# NEVER commit the real .env. Secrets are only in .env.
# ============================================================

# --- app ---
APP_ENV=dev
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# --- infrastructure ---
# PostgreSQL (prod); for quick local tests sqlite:///./clipper-dev.db is acceptable
DATABASE_URL=postgresql+psycopg://clipper:clipper@localhost:5432/clipper
REDIS_URL=redis://localhost:6379/0
# empty => falls back to REDIS_URL
CELERY_BROKER_URL=
# 1 => run Celery tasks synchronously (dev without Redis); uncomment if needed
# CELERY_TASK_ALWAYS_EAGER=1

# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clipper
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=false

# --- security ---
# Fernet key. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- upload / clips ---
UPLOAD_MAX_MB=1024
CLIP_MIN_SEC=5
CLIP_MAX_SEC=180

# --- ffmpeg ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT_SEC=600

# --- whisper (Stage 3) ---
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_BEAM_SIZE=3

# --- local LLM (Stage 2) ---
LLM_BACKEND=fake
LLM_MODEL_NAME=Qwen2.5-7B-Instruct-Q4_K_M
LLM_DEVICE=auto
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SEC=120

# --- ai heuristics weights (Stage 3) ---
AI_WEIGHTS_SPEECH=0.3
AI_WEIGHTS_KEYWORDS=0.25
AI_WEIGHTS_TEMPO=0.15
AI_WEIGHTS_LOUDNESS=0.15
AI_WEIGHTS_SCENE=0.15

# --- platforms (Stage 1.4+; only names, no values) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# --- publish rate limits (Stage 5) ---
YOUTUBE_DAILY_LIMIT=10
TIKTOK_DAILY_LIMIT=10
PUBLISH_MIN_INTERVAL_SEC=300

# --- ML (Stage 7) ---
ML_MIN_SAMPLES=80
ML_ACTIVE_VERSION=
ML_MAX_AGE_DAYS=30

# --- frontend (frontend/.env) ---
VITE_API_URL=http://localhost:8000
